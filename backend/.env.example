# Port the Express server listens on
PORT=5000

# Set to "production" when serving the built frontend (frontend/dist)
NODE_ENV=development

# Allowed origin for the Vite dev server (development CORS only)
CLIENT_ORIGIN=http://localhost:5173

# Optional: personal access token (no scopes needed) to raise GitHub API rate limits
GITHUB_TOKEN=

# --- Email provider: pick ONE of the two options below ---

# Option A (recommended): Brevo (formerly Sendinblue) transactional email API.
# Get a key from https://app.brevo.com/settings/keys/api — no SMTP setup needed.
# BREVO_SENDER_EMAIL must be a sender verified in your Brevo account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Portfolio

# Option B: plain SMTP (Gmail App Password, SendGrid, Mailgun, etc.) — only used
# if BREVO_API_KEY above is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# If neither option is configured, messages are just logged to the server console.

# Where contact form submissions + visit notifications should be delivered
CONTACT_TO_EMAIL=sheikhnoorabdullah02@gmail.com

# Email you whenever a new visitor loads the site. Set to "false" to turn this off.
ENABLE_VISIT_NOTIFICATIONS=true

# Public URL of the deployed site (no trailing slash). Used for the "Reply from Admin
# Panel" / "Visit my portfolio" buttons inside emails; buttons are hidden when empty.
SITE_URL=

# Password for the /admin page (messages inbox + visitor log).
# Leave empty to disable the admin panel entirely. Pick something you don't use anywhere else.
ADMIN_PASSWORD=

# Groq API key for the AI chat assistant
GROQ_API_KEY=
