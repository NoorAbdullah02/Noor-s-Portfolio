# Port the Express server listens on
PORT=5000

# Set to "production" when serving the built frontend (frontend/dist)
NODE_ENV=development

# Allowed origin for the Vite dev server (development CORS only)
CLIENT_ORIGIN=http://localhost:5173

# Optional: personal access token (no scopes needed) to raise GitHub API rate limits
GITHUB_TOKEN=

# SMTP settings for the contact form (e.g. Gmail App Password, SendGrid, Mailgun, etc.)
# If left empty, submitted messages are just logged to the server console instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Where contact form submissions should be delivered (defaults to SMTP_USER)
CONTACT_TO_EMAIL=sheikhnoorabdullah02@gmail.com
